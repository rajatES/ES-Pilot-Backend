# ── Server ─────────────────────────────────────────────────────────────
PORT=4000
# Comma-separated list of frontend origins allowed to call this API (CORS).
CORS_ORIGINS=http://localhost:3000
# Public URL of the frontend, used to redirect back after OAuth callbacks.
FRONTEND_URL=http://localhost:3000

# ── Database (Postgres) ────────────────────────────────────────────────
# Docker: `docker compose up -d postgres-db` starts it. When the backend runs
# OUTSIDE docker (npm run dev) use DB_HOST=localhost and publish the container
# port; docker-compose overrides DB_HOST to the service name for the container.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_NAME=posting_pilot_db
# true = TypeORM creates/updates tables from the entities on boot (dev).
# Set to false and use migrations once there's production data.
DB_SYNC=true

# ── Auth (JWT) ─────────────────────────────────────────────────────────
# Secret used to sign session tokens — use a long random string in production.
JWT_SECRET=
JWT_EXPIRES_IN=30d

# ── Media storage (AWS S3) ─────────────────────────────────────────────
# Uploaded media must be publicly fetchable — Meta/X/YouTube download it by URL.
S3_BUCKET=
AWS_REGION=us-east-1
# On EC2 prefer an IAM role (leave the keys blank). For local dev set both:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: serve via CloudFront/custom domain instead of the raw S3 URL.
S3_PUBLIC_URL=

# ── Facebook / Instagram ───────────────────────────────────────────────
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# 'live' to actually publish, anything else for dry-run (see lib/facebook.js).
FACEBOOK_PUBLISH_MODE=
FACEBOOK_REDIRECT_URI=
NEXT_PUBLIC_FACEBOOK_APP_ID=

# ── Instagram (direct connect — no Facebook Page) ──────────────────────
# The SECOND native Instagram path: the user signs in on instagram.com, and no
# Facebook Page, Business Portfolio or Facebook account is involved. The account
# must still be a professional (Creator/Business) one — no API publishes to a
# plain personal profile.
#
# These are NOT the FACEBOOK_CLIENT_ID/SECRET above. Get them from the same
# Meta app under: App Dashboard → Instagram → API setup with Instagram login
# → "Business login settings" (Instagram App ID + Instagram App Secret).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Must be listed verbatim under that same screen. NOTE the field there is called
# just "Redirect URL" — NOT "Valid OAuth Redirect URIs", which is the Facebook
# Login for Business label and does not exist on the Instagram screen. Path:
#   Instagram → API setup with Instagram login → "3. Set up Instagram business
#   login" → Set up → Redirect URL.
# Meta requires HTTPS here — localhost is exempt.
INSTAGRAM_REDIRECT_URI=http://localhost:4000/api/auth/instagram/callback
#
# The same "Business login settings" screen also asks for two callbacks. Both are
# served by modules/meta-callbacks and need NO env vars -- just paste the URLs:
#   Deauthorize callback URL  -> https://<backend>/api/meta/deauthorize
#   Data deletion request URL -> https://<backend>/api/meta/data-deletion
# The data-deletion one must be that CALLBACK, not the /data-deletion page: Meta
# expects JSON {url, confirmation_code} back, so an HTML page there fails.

# ── Google / YouTube ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Some YouTube helpers read the public client id under its NEXT_PUBLIC_ name.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
YOUTUBE_REDIRECT_URI=

# ── Caddy (production docker compose only) ─────────────────────────────
# The public domain Caddy obtains a Let's Encrypt certificate for. docker
# compose reads this file for ${CADDY_DOMAIN} substitution — if it's unset,
# Caddy falls back to "localhost" and HTTPS on the real domain BREAKS with
# a TLS internal_error alert (this has bitten a rebuild once already).
CADDY_DOMAIN=localhost

# ── Postiz (Threads + standalone Instagram + X) ────────────────────────
# These three publish through Postiz, which owns their OAuth and platform
# tokens — we hold one workspace key. It replaced the native Threads app (never
# approved by Meta), reaches Instagram accounts with no linked Facebook Page,
# and replaced the native X path (posting on X needs a paid API tier).
# Facebook Pages and YouTube stay on our own apps.
#
# Key: Postiz → Settings → Developers → "Your API key". Requires Postiz Cloud
# Standard or above; self-hosted has the public API enabled by default. It is
# sent raw in the Authorization header (no "Bearer " prefix) and never expires,
# so rotating in Postiz is the only way to revoke it.
#
# Connect the Threads / Instagram channel inside Postiz first, then import it
# in Pilot: Accounts → Connect → Postiz.
POSTIZ_API_KEY=
# Only set this for a self-hosted Postiz; cloud uses the default below.
# POSTIZ_API_URL=https://api.postiz.com/public/v1

# ── X (Twitter) ────────────────────────────────────────────────────────
# Nothing to set. X publishes through Postiz (see POSTIZ_API_KEY above), so
# there is no X developer app any more — posting on X needs a paid API tier we
# never bought, and the native path never published a single post. The old
# X_CLIENT_ID / X_CLIENT_SECRET / X_REDIRECT_URI were removed 2026-08-21.

# ── Canva ──────────────────────────────────────────────────────────────
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=

# ── AI (Anthropic) ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Cron ───────────────────────────────────────────────────────────────
# Shared secret required to invoke the /api/cron/* endpoints.
CRON_SECRET=
