# ── Server ─────────────────────────────────────────────────────────────
PORT=4000
# Comma-separated list of frontend origins allowed to call this API (CORS).
CORS_ORIGINS=http://localhost:3000
# Public URL of the frontend, used to redirect back after OAuth callbacks.
FRONTEND_URL=http://localhost:3000

# ── Supabase ───────────────────────────────────────────────────────────
# Project URL (either name works; SUPABASE_URL preferred on the backend).
SUPABASE_URL=
# Service-role key — server-only, bypasses RLS. NEVER expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Anon/publishable key — used only to validate incoming Bearer session tokens.
SUPABASE_ANON_KEY=

# ── Facebook / Instagram ───────────────────────────────────────────────
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# 'live' to actually publish, anything else for dry-run (see lib/facebook.js).
FACEBOOK_PUBLISH_MODE=
FACEBOOK_REDIRECT_URI=
NEXT_PUBLIC_FACEBOOK_APP_ID=

# ── Google / YouTube ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Some YouTube helpers read the public client id under its NEXT_PUBLIC_ name.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
YOUTUBE_REDIRECT_URI=

# ── Threads ────────────────────────────────────────────────────────────
# Separate credentials from the Facebook app: enable the "Threads API" use
# case in the Meta dashboard and copy the Threads App ID/secret it issues.
THREADS_APP_ID=
THREADS_APP_SECRET=
# Must be registered in the Threads use case settings; points at THIS backend.
THREADS_REDIRECT_URI=http://localhost:4000/api/auth/threads/callback

# ── X (Twitter) ────────────────────────────────────────────────────────
# From the X developer portal (project app, OAuth 2.0 settings, Web App type).
# Requires a tier with write access (Free tier allows limited posting).
X_CLIENT_ID=
X_CLIENT_SECRET=
# Must be registered in the app's OAuth 2.0 settings; points at THIS backend.
X_REDIRECT_URI=http://localhost:4000/api/auth/x/callback

# ── Canva ──────────────────────────────────────────────────────────────
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=

# ── AI (Anthropic) ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Cron ───────────────────────────────────────────────────────────────
# Shared secret required to invoke the /api/cron/* endpoints.
CRON_SECRET=
